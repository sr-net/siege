{
  "name": "@sr-net/siege",
  "version": "1.0.0",
  "author": "BeeeQueue",
  "type": "module",
  "private": true,
  "repository": {
    "type": "github",
    "url": "sr-net/siege"
  },
  "engines": {
    "node": "^26"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "imports": {
    "#/*": "./src/*",
    "#dbschema/*.ts": "./dbschema/*.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file .env src/index.ts",
    "db:reset": "nu scripts/db-reset.nu",
    "docker:build": "docker build . --tag siege",
    "docker:prune": "docker image prune --force",
    "docker:run": "docker run --rm --name siege -p 3000:3000 siege",
    "gen": "@gel/generate interfaces",
    "lint": "oxlint",
    "postinstall": "simple-git-hooks",
    "snapshot": "node src/index.ts -shot",
    "start": "node src/index.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@gqloom/valibot": "0.16.0",
    "@hono/graphql-server": "0.7.0",
    "@hono/node-server": "2.1.5",
    "gel": "2.2.1",
    "graphql": "16.14.2",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "ts-dedent": "2.3.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@gel/generate": "0.7.1",
    "@gqloom/core": "0.16.2",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "simple-git-hooks": "2.14.0",
    "vitest": "5.0.5"
  }
}
