{
  "name": "@sr-net/siege",
  "version": "1.0.0",
  "author": "BeeeQueue",
  "type": "module",
  "private": true,
  "repository": {
    "type": "github",
    "url": "sr-net/siege"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "^26"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "imports": {
    "#/*": "./src/*",
    "#dbschema/*.ts": "./dbschema/*.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file .env src/index.ts",
    "db:reset": "nu scripts/db-reset.nu",
    "docker:build": "docker build . --tag siege",
    "docker:prune": "docker image prune --force",
    "docker:run": "docker run --rm --name siege -p 3000:3000 siege",
    "gen": "@gel/generate interfaces",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "postinstall": "simple-git-hooks",
    "snapshot": "node src/index.ts -shot",
    "start": "node src/index.ts",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@gqloom/valibot": "0.16.0",
    "@hono/graphql-server": "0.7.0",
    "@hono/node-server": "2.0.2",
    "gel": "2.2.0",
    "graphql": "16.14.0",
    "hono": "4.12.21",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "ts-dedent": "2.2.0",
    "valibot": "1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@gel/generate": "0.7.1",
    "@gqloom/core": "0.16.1",
    "@tsconfig/node22": "22.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "25.8.0",
    "eslint": "10.4.0",
    "lint-staged": "17.0.5",
    "oxfmt": "0.50.0",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
